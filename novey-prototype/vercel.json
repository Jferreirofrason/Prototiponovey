{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/productos",
      "permanent": false
    },
    {
      "source": "/producto/:id",
      "destination": "/productos/producto/:id",
      "permanent": false
    }
  ]
}